#!/usr/bin/env bash

cd tests/e2e

failure="false"

if [ -f error.log ]
then
    :> error.log
fi

touch error.log

declare -A testCases
testCases["Plain"]="common"
testCases["Function"]="common"
testCases["TestCase"]="common exclude multiSrc"

for testCase in "${!testCases[@]}"; do
  for configCase in ${testCases[$testCase]}; do
    echo ""
    echo "== Testing suite $testCase - $configCase =="

    output=$(bash run_tests.bash $testCase $configCase)

    if [ $? != 0 ]; then
        failure="true"
        echo "" >> error.log
        echo "== Suite $testCase - $configCase ==" >> error.log
        echo "$output" >> error.log
        echo "" >> error.log
    fi
    echo ""
  done
done

if [ $failure = "true" ]; then
    echo "One of the e2e tests failed, check the logs"
    cat error.log
    exit 1
fi

echo -e "\nSuccess"
exit 0
