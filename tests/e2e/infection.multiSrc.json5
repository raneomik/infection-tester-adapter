{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "timeout": 25,
    "source": {
        "directories": [
            "src/Covered",
            "src/Inner"
        ],
    },
    "logs": {
        "summary": "var/infection-multiSrc.log",
        "text": "var/report-multiSrc.log",
        "html": "var/report-multiSrc.html"
    },
    "tmpDir": "var/infection-multiSrc",
    "testFramework": "tester",
    "mutators": {
        "@default": true
    }
}
